    @keyframes profileReveal {
      0% {
        opacity: 0;
        transform: translateY(-16px) scale(0.85);
        filter: blur(8px);
      }

      100% {
        opacity: 1;
        transform: translateY(0) scale(1);
        filter: blur(0);
      }
    }

    .avatar-wrapper {
      position: relative;
      display: inline-block;
      margin-bottom: 12px;
    }

    .floating-crown {
      position: absolute;
      top: -24px;
      left: 50%;
      transform: translateX(-50%);
      font-size: 36px;
      color: #fbbf24;
      filter: drop-shadow(0 0 16px rgba(251, 191, 36, 0.95));
      z-index: 10;
      animation: floatCrown 3s cubic-bezier(0.45, 0.05, 0.55, 0.95) infinite;
    }

    @keyframes floatCrown {

      0%,
      100% {
        transform: translateX(-50%) translateY(0) rotate(0deg) scale(1);
      }

      50% {
        transform: translateX(-50%) translateY(-8px) rotate(-4deg) scale(1.06);
      }
    }

    .avatar-ring {
      width: 140px;
      height: 140px;
      border-radius: 50%;
      border: 3.5px solid #f59e0b;
      padding: 4px;
      background: rgba(15, 21, 35, 0.7);
      box-shadow:
        0 0 35px rgba(245, 158, 11, 0.6),
        0 0 70px rgba(245, 158, 11, 0.25),
        inset 0 0 20px rgba(245, 158, 11, 0.35);
      transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.4s ease;
      animation: ringAuraPulse 3s infinite ease-in-out;
    }

    @keyframes ringAuraPulse {

      0%,
      100% {
        box-shadow:
          0 0 30px rgba(245, 158, 11, 0.6),
          0 0 60px rgba(245, 158, 11, 0.2),
          inset 0 0 15px rgba(245, 158, 11, 0.3);
      }

      50% {
        box-shadow:
          0 0 48px rgba(245, 158, 11, 0.85),
          0 0 95px rgba(245, 158, 11, 0.45),
          inset 0 0 25px rgba(245, 158, 11, 0.5);
      }
    }

    .avatar-ring:hover {
      transform: scale(1.05) rotate(2deg);
    }

    .avatar-img {
      width: 100%;
      height: 100%;
      border-radius: 50%;
      object-fit: cover;
      display: block;
    }

    .profile-username {
      font-family: 'Outfit', sans-serif;
      font-size: 28px;
      font-weight: 800;
      color: #ffffff;
      margin-bottom: 8px;
      letter-spacing: -0.3px;
      word-break: break-word;
      text-shadow: 0 2px 12px rgba(0, 0, 0, 0.6);
    }

    .receipt-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(15, 21, 35, 0.85);
      border: 1.5px solid rgba(245, 158, 11, 0.65);
      color: #fbbf24;
      padding: 7px 20px;
      border-radius: 30px;
      font-size: 13px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      box-shadow: 0 0 20px rgba(245, 158, 11, 0.25);
      animation: badgeGlow 2.5s ease-in-out infinite alternate;
    }

    @keyframes badgeGlow {
      from {
        box-shadow: 0 0 15px rgba(245, 158, 11, 0.2);
      }

      to {
        box-shadow: 0 0 25px rgba(245, 158, 11, 0.45);
      }
