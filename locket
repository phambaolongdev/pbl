      margin: 0;
      padding: 0;
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      background-color: var(--bg-dark);
      background-image:
        radial-gradient(circle at 50% 0%, rgba(251, 191, 36, 0.22) 0%, transparent 55%),
        radial-gradient(circle at 50% 35%, rgba(6, 182, 212, 0.12) 0%, transparent 60%),
        radial-gradient(circle at 80% 90%, rgba(139, 92, 246, 0.18) 0%, transparent 55%),
        linear-gradient(180deg, rgba(7, 7, 16, 0.9) 0%, rgba(9, 11, 22, 0.98) 100%),
