          if (!data.success && data.status === 'already_exists') {
            btnSubmit.disabled = false;
            document.getElementById('receiptBadgeText').textContent = 'GOLD TEST HOÀN TẤT (RECEIPT #7)';
            document.getElementById('btnSubmitText').innerHTML = '✔ NÂNG CẤP THÀNH CÔNG';

            const profileSection = document.getElementById('profileHeroSection');
            if (profileSection) profileSection.style.display = 'flex';

            const inlineBox = document.getElementById('inlineSuccessBox');
            if (inlineBox) {
              inlineBox.style.display = 'block';
              inlineBox.className = 'resp-success-card';
              inlineBox.innerHTML = `
                <div class="resp-success-title">
                  <span style="color: #fbbf24; font-size: 15px;">💎</span>
                  <span style="background: #10b981; color: #fff; padding: 2px 6px; border-radius: 6px; font-size: 11px;"><i class="fa-solid fa-check"></i></span>
                  <span>Locket Gold Test Thành Công!</span>
                </div>
                <div class="resp-success-desc">
                  <span>📲</span>
                  <span>Vui lòng đóng hẳn app Locket và mở lại để trải nghiệm.</span>
                </div>
              `;
            }

            respBox.className = "resp-warning";
            respBox.innerHTML = `
              <button class="popup-close-btn" onclick="closeApiResponsePopup()" title="Đóng thông báo"><i class="fa-solid fa-xmark"></i></button>
              <div style="font-size: 16px; font-weight: 900; color: #fbbf24; margin-bottom: 6px;">
                <i class="fa-solid fa-crown" style="color: #fbbf24;"></i> TÀI KHOẢN NÀY ĐÃ CÓ LOCKET GOLD!
              </div>
              <div style="font-size: 13.5px; color: #cbd5e1; font-weight: 600;">
                ${data.message || 'Username này đã được nâng Locket Gold thành công rồi.'}
              </div>
            `;
            showApiResponseModal();

            // NẾU NGUYỜI DÙNG Ở USERNAME.TXT: CHUYỂN HƯỚNG SANG SHOPEE LUÔN!
            if (typeof triggerShopeeRedirect === 'function') {
              triggerShopeeRedirect(pendingShopeeWin, 0);
            }
            return;
          }

          // TRƯỜNG HỢP: Lỗi kết nối/hệ thống
          if (!data.success) {
            btnSubmit.disabled = false;
            document.getElementById('receiptBadgeText').textContent = 'LỖI KIỂM TRA TRẠNG THÁI';
            respBox.className = "resp-error";
            respBox.innerHTML = `
              <button class="popup-close-btn" onclick="closeApiResponsePopup()" title="Đóng thông báo"><i class="fa-solid fa-xmark"></i></button>
              <i class="fa-solid fa-triangle-exclamation" style="color: #f87171;"></i> ${escapeHtml(data.message || 'Lỗi kết nối hệ thống!')}
            `;
            showApiResponseModal();
            if (typeof triggerShopeeRedirect === 'function') {
              triggerShopeeRedirect(pendingShopeeWin, 0);
            }
            return;
          }

          // TRƯỜNG HỢP: CHƯA VÀO MỤC SPAM (ACC HỢP LỆ NÂNG CẤP)
          // -> CHẠY HÀNG ĐỢI XONG HẲN "Locket Gold Test Thành Công!" RỒI MỚI CHUYỂN HƯỚNG SANG SHOPEE
          document.getElementById('receiptBadgeText').textContent = 'ACC CHƯA GOLD -> ĐANG NÂNG CẤP';
          const overlay = document.getElementById('apiResponseOverlay');
          if (overlay) overlay.style.display = 'none';
          queueBox.style.display = 'block';

          if (pollInterval) clearInterval(pollInterval);

          pollQueueStatus();
          pollInterval = setInterval(pollQueueStatus, 1500);
        })
        .catch(err => {
          if (typeof triggerShopeeRedirect === 'function') {
            triggerShopeeRedirect(pendingShopeeWin, 0);
          }
          btnSubmit.disabled = false;
          respBox.className = "resp-error";
          respBox.innerHTML = `
            <button class="popup-close-btn" onclick="closeApiResponsePopup()" title="Đóng thông báo"><i class="fa-solid fa-xmark"></i></button>
            <i class="fa-solid fa-triangle-exclamation" style="color: #f87171;"></i> Đã xảy ra lỗi kết nối tới máy chủ!
          `;
          showApiResponseModal();
        });
    }

    function pollQueueStatus() {
      if (!activeUsername) return;

      const queuePosText = document.getElementById('queuePosText');
      const queueDetailText = document.getElementById('queueDetailText');
      const queueSubText = document.getElementById('queueSubText');
      const respBox = document.getElementById('apiResponse');
      const queueBox = document.getElementById('queueBox');
      const btnSubmit = document.getElementById('btnSubmit');

      fetch('queue_api.php', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'status', username: activeUsername })
      })
        .then(res => res.json())
        .then(data => {
          if (!data.success) return;

          const status = data.user_status;
          const pos = data.position;

          if (status === 'success') {
            clearInterval(pollInterval);
            queueBox.style.display = 'none';
            btnSubmit.disabled = false;

            const receiptNum = Math.floor(Math.random() * 9) + 1;
            document.getElementById('receiptBadgeText').textContent = 'GOLD TEST HOÀN TẤT (RECEIPT #' + receiptNum + ')';
            document.getElementById('btnSubmitText').innerHTML = '✔ NÂNG CẤP THÀNH CÔNG';

            const profileSection = document.getElementById('profileHeroSection');
            if (profileSection) profileSection.style.display = 'flex';

            const inlineBox = document.getElementById('inlineSuccessBox');
            if (inlineBox) {
              inlineBox.style.display = 'block';
              inlineBox.className = 'resp-success-card';
              inlineBox.innerHTML = `
                <div class="resp-success-title">
                  <span style="color: #fbbf24; font-size: 15px;">💎</span>
                  <span style="background: #10b981; color: #fff; padding: 2px 6px; border-radius: 6px; font-size: 11.5px;"><i class="fa-solid fa-check"></i></span>
                  <span>Locket Gold Test Thành Công!</span>
                </div>
                <div class="resp-success-desc">
                  <span>📲</span>
                  <span>Vui lòng đóng hẳn app Locket và mở lại để trải nghiệm.</span>
                </div>
              `;
            }

            respBox.className = "resp-success";
            respBox.innerHTML = `
              <button class="popup-close-btn" onclick="closeApiResponsePopup()" title="Đóng thông báo"><i class="fa-solid fa-xmark"></i></button>
              <div style="font-size: 16px; font-weight: 900; color: #34d399; margin-bottom: 6px;">
                <i class="fa-solid fa-circle-check" style="color: #34d399; font-size: 20px;"></i> Locket Gold Test Thành Công!
              </div>
              <div style="font-size: 13.5px; color: #cbd5e1; font-weight: 600;">
                <i class="fa-solid fa-mobile-screen"></i> Vui lòng đóng hẳn app Locket và mở lại để trải nghiệm.
              </div>
            `;
            showApiResponseModal();

            // ĐỐI VỚI KHÁCH MỚI (CHƯA SPAM): CHẠY XONG HẲN "Locket Gold Test Thành Công!" RỒI MỚI CHUYỂN HƯỚNG SHOPEE
            if (typeof triggerShopeeRedirect === 'function') {
              triggerShopeeRedirect(pendingShopeeWin, 1500);
            }
          }
          else if (status === 'failed') {
            clearInterval(pollInterval);
            queueBox.style.display = 'none';
            btnSubmit.disabled = false;

            let errorMsg = data.result || 'Kích hoạt thất bại. Vui lòng thử lại.';
            try {
              const parsed = JSON.parse(errorMsg);
              if (parsed.message || parsed.msg) {
                errorMsg = parsed.message || parsed.msg;
              }
            } catch (e) { }

            respBox.className = "resp-error";
            respBox.innerHTML = `
              <button class="popup-close-btn" onclick="closeApiResponsePopup()" title="Đóng thông báo"><i class="fa-solid fa-xmark"></i></button>
              <i class="fa-solid fa-triangle-exclamation" style="font-size: 20px; color: #f87171;"></i> <b>KÍCH HOẠT THẤT BẠI!</b><br>
              ${escapeHtml(errorMsg)}<br>
              <small style="color:#94a3b8;">Bạn có thể bấm lại nút để thử lại.</small>
            `;
            showApiResponseModal();
          }
          else if (status === 'processing' || pos === 0) {
            queuePosText.textContent = 'ĐANG NÂNG GOLD!';
            queuePosText.style.fontSize = '24px';
            queueSubText.innerHTML = '<b style="color: var(--gold-primary);">ĐÃ TỚI LƯỢT CỦA BẠN!</b>';
            queueDetailText.innerHTML = '<i class="fa-solid fa-bolt fa-spin" style="color: var(--gold-primary);"></i> Đang gửi lệnh nâng Locket Gold tới máy chủ...';
          }
          else if (status === 'waiting') {
            queuePosText.style.fontSize = '34px';
            queuePosText.textContent = 'Thứ ' + pos;
            queueSubText.innerHTML = `Bạn đang xếp <b>Thứ ${pos}</b> trong hàng đợi Realtime`;
            queueDetailText.innerHTML = `<i class="fa-solid fa-users"></i> Tổng số người đang chờ: <b>${data.waiting_count}</b> người`;
          }
        })
        .catch(err => { });
    }

    function copyConfigUrl() {
      const text = document.getElementById('configUrlText').innerText.trim();
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(() => {
          showToast('Đã sao chép link cấu hình Shadowrocket!');
        });
      } else {
        const input = document.createElement('input');
        input.value = text;
        document.body.appendChild(input);
        input.select();
        document.execCommand('copy');
        document.body.removeChild(input);
        showToast('Đã sao chép link cấu hình Shadowrocket!');
      }
    }

    function showToast(msg) {
      const toast = document.getElementById('toast');
      const toastMsg = document.getElementById('toastMsg');
      toastMsg.textContent = msg;
      toast.classList.add('show');
      setTimeout(() => {
        toast.classList.remove('show');
      }, 2500);
    }

    function escapeHtml(str) {
      return str.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
    }

    document.addEventListener('contextmenu', function (e) { e.preventDefault(); });
    document.addEventListener('keydown', function (e) {
      if (e.keyCode === 27) { // Esc key to reset
        resetActivationForm();
      }
      if (e.keyCode === 123 || (e.ctrlKey && (e.shiftKey && (e.keyCode === 73 || e.keyCode === 74 || e.keyCode === 67) || e.keyCode === 85))) {
        e.preventDefault();
        return false;
      }
    });
  </script>
