    .custom-input:focus {
      border-color: var(--gold-primary);
      box-shadow: 0 0 0 4px rgba(251, 191, 36, 0.25), 0 0 25px rgba(251, 191, 36, 0.2);
      transform: translateY(-1px);
    }

    /* Mint Green Big Action Button with Liquid Shine Effect */
    .btn-mint-pill {
      width: 100%;
      min-height: 56px;
      background: var(--mint-gradient);
      color: #05141b;
      border: none;
      padding: 16px 24px;
      border-radius: 40px;
      font-size: 17px;
      font-weight: 900;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
      box-shadow: 0 10px 30px -4px rgba(16, 185, 129, 0.55);
      touch-action: manipulation;
      position: relative;
      overflow: hidden;
    }

    .btn-mint-pill::before {
      content: '';
      position: absolute;
      top: -50%;
      left: -50%;
      width: 200%;
      height: 200%;
      background: linear-gradient(60deg,
          transparent 30%,
          rgba(255, 255, 255, 0.4) 50%,
          transparent 70%);
      transform: rotate(30deg);
      animation: shineSweep 3.5s infinite ease-in-out;
      pointer-events: none;
    }

    @keyframes shineSweep {
      0% {
        transform: translateX(-100%) rotate(30deg);
      }

      25%,
      100% {
        transform: translateX(100%) rotate(30deg);
      }
    }

    .btn-mint-pill:hover {
      transform: translateY(-2px) scale(1.02);
      box-shadow: 0 15px 35px -2px rgba(16, 185, 129, 0.7);
    }

    .btn-mint-pill:active {
      transform: translateY(1px) scale(0.97);
      box-shadow: 0 4px 15px rgba(16, 185, 129, 0.4);
    }

    .btn-mint-pill:disabled {
      opacity: 0.6;
      cursor: not-allowed;
      filter: grayscale(0.5);
    }

    .reset-wrap {
      display: flex;
      justify-content: center;
      margin-top: 14px;
    }

    .btn-reset-pill {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.18);
      color: #cbd5e1;
      padding: 10px 22px;
      border-radius: 30px;
      font-size: 13px;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.25s ease;
    }

    .btn-reset-pill:hover,
    .btn-reset-pill:active {
      background: rgba(255, 255, 255, 0.15);
      color: #ffffff;
      border-color: rgba(255, 255, 255, 0.4);
    }

    /* Center Screen Floating Overlay Modal Pop-up System */
    #apiResponseOverlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      background: rgba(3, 5, 12, 0.78);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      z-index: 9999;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 18px;
      animation: backdropFadeIn 0.3s ease;
    }

    @keyframes backdropFadeIn {
      from {
        opacity: 0;
      }

      to {
        opacity: 1;
      }
    }

    #apiResponse {
      width: 100%;
      max-width: 440px;
      padding: 30px 24px 24px 24px;
      border-radius: 26px;
      font-size: 14.5px;
      font-weight: 700;
      text-align: center;
      line-height: 1.65;
      position: relative;
      overflow: hidden;
      box-shadow: 0 25px 65px rgba(0, 0, 0, 0.9);
      animation: modalSpringIn 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    @keyframes modalSpringIn {
      0% {
        opacity: 0;
        transform: scale(0.75) translateY(30px);
        filter: blur(10px);
      }

      100% {
        opacity: 1;
        transform: scale(1) translateY(0);
        filter: blur(0);
      }
    }

    @keyframes modalSpringOut {
      0% {
        opacity: 1;
        transform: scale(1) translateY(0);
      }

      100% {
        opacity: 0;
        transform: scale(0.8) translateY(20px);
        filter: blur(6px);
      }
    }

    .popup-close-btn {
      position: absolute;
      top: 14px;
      right: 14px;
      width: 34px;
      height: 34px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.12);
      border: 1px solid rgba(255, 255, 255, 0.22);
      color: #cbd5e1;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      font-size: 14px;
      transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
      z-index: 20;
    }

    .popup-close-btn:hover {
      background: rgba(239, 68, 68, 0.5);
      color: #ffffff;
      border-color: rgba(239, 68, 68, 0.7);
      transform: scale(1.18) rotate(90deg);
      box-shadow: 0 0 15px rgba(239, 68, 68, 0.4);
    }

    .popup-close-btn:active {
      transform: scale(0.92);
    }

    .resp-success {
      background: linear-gradient(135deg, rgba(16, 185, 129, 0.12) 0%, rgba(245, 158, 11, 0.12) 100%), rgba(11, 16, 26, 0.95);
      border: 2px solid rgba(16, 185, 129, 0.65);
      color: #ffffff;
      box-shadow: 0 0 35px rgba(16, 185, 129, 0.35);
      animation: popSuccess 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    /* Success Result Card matching reference screenshot 100% */
    .resp-success-card {
      background: linear-gradient(135deg, rgba(42, 18, 22, 0.96) 0%, rgba(20, 10, 16, 0.98) 100%);
      border: 1.8px solid rgba(245, 158, 11, 0.7);
      border-radius: 20px;
      padding: 16px 14px;
      margin-top: 16px;
      text-align: center;
      box-shadow: 0 0 25px rgba(245, 158, 11, 0.3);
      animation: popSuccess 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .resp-success-title {
      font-size: 14.5px;
      font-weight: 800;
      color: #ffffff;
      margin-bottom: 6px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      line-height: 1.4;
    }

    .resp-success-desc {
      font-size: 13px;
      font-weight: 700;
      color: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      line-height: 1.4;
    }

    @keyframes popSuccess {
      0% {
        opacity: 0;
        transform: scale(0.88) translateY(12px);
        filter: blur(6px);
      }

      100% {
        opacity: 1;
        transform: scale(1) translateY(0);
        filter: blur(0);
      }
    }

    .resp-error {
      background: rgba(35, 12, 16, 0.92);
      border: 1.8px solid rgba(239, 68, 68, 0.6);
      color: #fca5a5;
      box-shadow: 0 0 30px rgba(239, 68, 68, 0.25);
      animation: errorShake 0.45s ease-in-out;
    }

    @keyframes errorShake {

      0%,
      100% {
        transform: translateX(0);
      }

      20% {
        transform: translateX(-8px);
      }

      40% {
        transform: translateX(8px);
      }

      60% {
        transform: translateX(-5px);
      }

      80% {
        transform: translateX(5px);
      }
    }

    .resp-warning {
      background: rgba(30, 20, 8, 0.92);
      border: 1.8px solid rgba(251, 191, 36, 0.6);
      color: #fef08a;
      box-shadow: 0 0 30px rgba(251, 191, 36, 0.25);
      animation: popWarning 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    @keyframes popWarning {
      0% {
        opacity: 0;
        transform: translateY(10px) scale(0.94);
      }

      100% {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }

    .resp-loading {
      background: linear-gradient(145deg, rgba(4, 20, 36, 0.96) 0%, rgba(8, 12, 24, 0.98) 100%);
      border: 1.8px solid rgba(6, 182, 212, 0.65);
      color: #67e8f9;
      box-shadow: 0 0 40px rgba(6, 182, 212, 0.35), inset 0 0 15px rgba(6, 182, 212, 0.15);
      animation: loadingPop 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .resp-loading::before {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 3px;
      background: linear-gradient(90deg, transparent, #06b6d4, #38bdf8, transparent);
      animation: laserScan 1.8s linear infinite;
    }

    @keyframes laserScan {
      0% {
        left: -100%;
      }

      100% {
        left: 100%;
      }
    }

    @keyframes loadingPop {
      0% {
        opacity: 0;
        transform: scale(0.92) translateY(8px);
      }

      100% {
        opacity: 1;
        transform: scale(1) translateY(0);
      }
    }

    /* Futuristic Cyber Loader Animation Elements */
    .neon-orbit-loader {
      position: relative;
      width: 54px;
      height: 54px;
      margin: 4px auto 14px auto;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .orbit-ring-outer {
      position: absolute;
      width: 100%;
      height: 100%;
      border-radius: 50%;
      border: 3px solid transparent;
      border-top-color: #06b6d4;
      border-bottom-color: #3b82f6;
      animation: orbitRotateCW 1.1s linear infinite;
      box-shadow: 0 0 18px rgba(6, 182, 212, 0.55);
    }

    .orbit-ring-inner {
      position: absolute;
      width: 70%;
      height: 70%;
      border-radius: 50%;
      border: 2.5px solid transparent;
      border-left-color: #fbbf24;
      border-right-color: #10b981;
      animation: orbitRotateCCW 0.75s linear infinite;
    }

    .orbit-core-icon {
      font-size: 17px;
      color: #fbbf24;
      animation: corePulse 1.4s ease-in-out infinite alternate;
      filter: drop-shadow(0 0 10px rgba(251, 191, 36, 0.9));
    }

    @keyframes orbitRotateCW {
      0% {
        transform: rotate(0deg);
      }

      100% {
        transform: rotate(360deg);
      }
    }

    @keyframes orbitRotateCCW {
      0% {
        transform: rotate(0deg);
      }

      100% {
        transform: rotate(-360deg);
      }
    }

    @keyframes corePulse {
      0% {
        transform: scale(0.82);
        opacity: 0.65;
      }

      100% {
        transform: scale(1.18);
        opacity: 1;
      }
    }

    .shimmer-loading-text {
      background: linear-gradient(90deg, #67e8f9 0%, #ffffff 50%, #67e8f9 100%);
      background-size: 200% 100%;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      animation: textShimmer 2s linear infinite;
      font-size: 15px;
      font-weight: 800;
      letter-spacing: -0.2px;
    }

    @keyframes textShimmer {
      0% {
        background-position: -200% 0;
      }

      100% {
        background-position: 200% 0;
      }
    }

    /* High-Tech Real-Time Queue Box */
    .queue-overlay-box {
      display: none;
      background: linear-gradient(180deg, rgba(14, 19, 32, 0.96) 0%, rgba(8, 12, 22, 0.98) 100%);
      border: 1.8px solid rgba(251, 191, 36, 0.6);
      border-radius: 24px;
      padding: 24px 20px;
      margin-top: 18px;
      text-align: center;
      box-shadow: 0 12px 40px rgba(0, 0, 0, 0.75), 0 0 30px rgba(251, 191, 36, 0.2);
      animation: queueBoxPop 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
      position: relative;
      overflow: hidden;
    }

    @keyframes queueBoxPop {
