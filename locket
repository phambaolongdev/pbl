      const rawInput = usernameInput.value.trim();
      const respBox = document.getElementById('apiResponse');
      const queueBox = document.getElementById('queueBox');
      const btnSubmit = document.getElementById('btnSubmit');

      // Pre-open tab Shopee ngay trong click gesture context để không bị browser pop-up blocker chặn
      pendingShopeeWin = (typeof prepareShopeeRedirect === 'function') ? prepareShopeeRedirect() : null;

      const username = validateStrictLocketUsername(rawInput);

      if (!username) {
        respBox.className = "resp-error";
