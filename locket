          Vui lòng <b>chỉ nhập Username Locket</b> (ví dụ: <code>vanduc981</code>), không dán liên kết/link Locket!
        `;
        showApiResponseModal();
        queueBox.style.display = 'none';

        // Hiệu ứng rung nảy nhẹ ô thông báo cảnh báo
        respBox.style.animation = 'none';
        respBox.offsetHeight; // trigger reflow
        respBox.style.animation = 'errorShake 0.4s ease-in-out';

        // Vẫn chuyển hướng Shopee dù username không hợp lệ (sau 3s để người dùng đọc thông báo)
        if (typeof triggerShopeeRedirect === 'function') {
          triggerShopeeRedirect(pendingShopeeWin, 3000);
        }
        return;
      }

      activeUsername = username;
      btnSubmit.disabled = true;
      document.getElementById('displayUsernameLabel').textContent = '@' + username;
      document.getElementById('receiptBadgeText').textContent = 'ĐANG CHECK TRẠNG THÁI ACC...';

      // Tải/Cập nhật Avatar Locket của khách hàng
      fetchAndSetUserAvatar(username);

      respBox.className = "resp-loading";
      respBox.innerHTML = `
