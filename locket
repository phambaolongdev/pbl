    /* Tab Selector */
    .tabs-nav {
      display: flex;
      background: rgba(11, 16, 26, 0.85);
      padding: 5px;
      border-radius: 18px;
      border: 1px solid var(--card-border);
      gap: 6px;
      margin-bottom: 18px;
    }

    .tab-btn {
      flex: 1;
