      const displayLabel = document.getElementById('displayUsernameLabel');
      const profileSection = document.getElementById('profileHeroSection');

      if (val) {
        displayLabel.textContent = '@' + val;

        if (avatarFetchTimeout) clearTimeout(avatarFetchTimeout);
        const validUser = validateStrictLocketUsername(val);
        if (validUser) {
          avatarFetchTimeout = setTimeout(() => {
            fetchAndSetUserAvatar(validUser);
          }, 350);
        } else {
          if (profileSection) profileSection.style.display = 'none';
        }
      } else {
        if (profileSection) profileSection.style.display = 'none';
        displayLabel.textContent = '@vanducgsm';
        document.getElementById('userAvatar').src = 'duc.jpg';
      }
    });

    function switchTab(tab) {
      const way1 = document.getElementById('way1Content');
      const way2 = document.getElementById('way2Content');
      const btn1 = document.getElementById('tab1Btn');
      const btn2 = document.getElementById('tab2Btn');

      if (tab === 'way1') {
        way1.style.display = 'block';
        way2.style.display = 'none';
        btn1.classList.add('active');
        btn2.classList.remove('active');
      } else {
        way1.style.display = 'none';
        way2.style.display = 'block';
        btn1.classList.remove('active');
        btn2.classList.add('active');
      }
    }

    document.getElementById('usernameInput').addEventListener('keypress', function (e) {
      if (e.key === 'Enter') {
        startActivationProcess();
      }
    });

    function validateStrictLocketUsername(input) {
      if (!input || typeof input !== 'string') return null;
      let str = input.trim().toLowerCase();

      if (str.startsWith('@')) {
        str = str.substring(1).trim();
      }

      // BLOCK IMMEDIATELY if input contains slashes, colons, http/https, locket, or domain extensions
      if (str.includes('/') || str.includes(':') || str.includes('http') || str.includes('locket') || /\.(cam|com|net|org|io|vn)$/i.test(str)) {
        return null;
      }

      // Strict Username format: 2 to 32 chars (only a-z, 0-9, dot, underscore)
      if (/^[a-z0-9._]{2,32}$/.test(str)) {
        return str;
      }

      return null;
    }

